---
const { title } = Astro.props;
---

<!DOCTYPE html>
<html lang="en">
	<head>
		<meta charset="utf-8"/>
		<meta name="viewport" content="width=device-width, initial-scale=1"/>
		<meta name="generator" content={Astro.generator}/>
		<title>{title}</title>
	</head>
	<body>
		<main>
			<slot/>
		</main>
	</body>
</html>

<style is:global>
	:root {
		--background: #16181d;
		--surface: #1e2129;
		--text: #e7e9ee;
		--muted: #8b93a3;
		--grid: #2c313c;
		--prediction: #6b7280;
		--actual: #4ade80;
	}

	* {
		box-sizing: border-box;
	}

	body {
		margin: 0;
		padding: 3rem 1.5rem;
		background: var(--background);
		color: var(--text);
		font-family: system-ui, sans-serif;
		display: flex;
		justify-content: center;
	}

	main {
		width: 100%;
		max-width: 960px;
	}
</style>
