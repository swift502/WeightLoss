---
import Layout from '../layouts/Default.astro';
import measured from '../data/data.yml';
import target from '../data/target.yml';

interface Entry {
	date: string;
	weight: number;
}

const time = (date: string) => Date.parse(date);

const points: Entry[] = [...measured].sort((a, b) => time(a.date) - time(b.date));
const targetLine: Entry[] = [target.start, target.end];

// Chart geometry
const width = 900;
const height = 600;
const margin = { top: 12, right: 24, bottom: 40, left: 40 };

const times = [...targetLine, ...points].map(e => time(e.date));
const weights = [...targetLine, ...points].map(e => e.weight);
const tMin = Math.min(...times);
const tMax = Math.max(...times);
const kgMin = Math.floor(Math.min(...weights)) - 1;
const kgMax = Math.ceil(Math.max(...weights)) + 1;

const x = (t: number) => margin.left + (t - tMin) / (tMax - tMin) * (width - margin.left - margin.right);
const y = (kg: number) => margin.top + (kgMax - kg) / (kgMax - kgMin) * (height - margin.top - margin.bottom);

const polyline = (entries: Entry[]) => entries.map(e => `${x(time(e.date))},${y(e.weight)}`).join(' ');

// Ticks
const kgTicks = Array.from({ length: kgMax - kgMin + 1 }, (_, i) => kgMin + i);

const monthTicks: number[] = [];
const cursor = new Date(tMin);
cursor.setUTCDate(1);
cursor.setUTCHours(0, 0, 0, 0);
while (cursor.getTime() <= tMax) {
	if (cursor.getTime() >= tMin) monthTicks.push(cursor.getTime());
	cursor.setUTCMonth(cursor.getUTCMonth() + 1);
}

const day = 24 * 60 * 60 * 1000;
const mondayTicks: number[] = [];
const firstDay = new Date(tMin);
firstDay.setUTCHours(0, 0, 0, 0);
for (let t = firstDay.getTime() + ((8 - firstDay.getUTCDay()) % 7) * day; t <= tMax; t += 7 * day) {
	if (t >= tMin) mondayTicks.push(t);
}

const monthLabel = (t: number) => new Date(t).toLocaleDateString('en', { month: 'short', timeZone: 'UTC' });

// Next week target: upcoming Monday after the last measurement
const last = points[points.length - 1];
const lastTime = time(last.date);
const daysToMonday = (8 - new Date(lastTime).getUTCDay()) % 7 || 7;
const nextMonday = lastTime + daysToMonday * day;
const projected = last.weight - 0.5 * daysToMonday / 7;
const targetStart = time(target.start.date);
const targetEnd = time(target.end.date);
const onTargetLine = target.start.weight + (nextMonday - targetStart) / (targetEnd - targetStart) * (target.end.weight - target.start.weight);
const [rangeLow, rangeHigh] = [projected, onTargetLine].sort((a, b) => a - b);
const nextMondayLabel = new Date(nextMonday).toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit', timeZone: 'UTC' });
---

<Layout title="Tracking">
	<figure class="chart">
		<p class="next-target">
			<span class="next-target-label">Next week target · {nextMondayLabel}</span>
			<span class="next-target-value">{rangeLow.toFixed(1)}<small>kg</small> – {rangeHigh.toFixed(1)}<small>kg</small></span>
		</p>

		<svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label="Weight over time">
			{mondayTicks.map(t => (
				<line class="grid" x1={x(t)} x2={x(t)} y1={y(kgMax)} y2={y(kgMin)}/>
			))}

			{kgTicks.map(kg => (
				<>
					<line class="grid" x1={margin.left} x2={width - margin.right} y1={y(kg)} y2={y(kg)}/>
					<text class="label" x={margin.left - 12} y={y(kg)} text-anchor="end" dominant-baseline="middle">{kg}</text>
				</>
			))}

			{monthTicks.map(t => (
				<text class="label" x={x(t)} y={height - margin.bottom + 24} text-anchor="middle">{monthLabel(t)}</text>
			))}

			<line class="goal" x1={margin.left} x2={width - margin.right} y1={y(target.end.weight)} y2={y(target.end.weight)}/>

			<polyline class="target" points={polyline(targetLine)}/>
			<polyline class="actual" points={polyline(points)}/>

			{points.map(p => (
				<circle class="dot" cx={x(time(p.date))} cy={y(p.weight)} r="4">
					<title>{p.weight} kg</title>
				</circle>
			))}
		</svg>

		<figcaption>
			<span class="key target-key">Target</span>
			<span class="key goal-key">Goal</span>
			<span class="key actual-key">Data</span>
		</figcaption>
	</figure>
</Layout>

<style>
	.chart {
		margin: 0;
		padding: 2rem;
		background: var(--surface);
		border-radius: 12px;
	}

	.next-target {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		margin: 0 0 1rem;
	}

	.next-target-label {
		color: var(--muted);
		font-size: 0.8rem;
		letter-spacing: 0.08em;
		text-transform: uppercase;
	}

	.next-target-value {
		color: var(--text);
		opacity: 0.8;
		font-size: 1.75rem;
		font-weight: 600;
		font-variant-numeric: tabular-nums;
	}

	.next-target-value small {
		margin-left: 0.15em;
		font-size: 0.55em;
		font-weight: 400;
	}

	svg {
		display: block;
		width: 100%;
		height: auto;
		overflow: visible;
	}

	.grid {
		stroke: var(--grid);
		stroke-width: 1;
	}

	.goal {
		stroke: var(--goal);
		stroke-width: 1.5;
		opacity: 0.55;
	}

	.label {
		fill: var(--muted);
		font-size: 13px;
	}

	.target {
		fill: none;
		stroke: var(--prediction);
		stroke-width: 2;
		stroke-dasharray: 8 6;
	}

	.actual {
		fill: none;
		stroke: var(--actual);
		stroke-width: 2.5;
		stroke-linejoin: round;
	}

	.dot {
		fill: var(--actual);
	}

	figcaption {
		display: flex;
		flex-wrap: wrap;
		gap: 1.5rem;
		margin-top: 1rem;
		color: var(--muted);
		font-size: 0.9rem;
	}

	.key::before {
		content: '';
		display: inline-block;
		width: 14px;
		height: 2px;
		margin-right: 0.5rem;
		vertical-align: middle;
	}

	.target-key::before {
		background: var(--prediction);
	}

	.goal-key::before {
		background: var(--goal);
	}

	.actual-key::before {
		background: var(--actual);
	}
</style>
