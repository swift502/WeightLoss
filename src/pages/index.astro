---
import Layout from '../layouts/Default.astro';
import measured from '../data/data.yml';
import target from '../data/target.yml';

interface Entry {
	date: string;
	weight: number;
}

const time = (date: string) => Date.parse(date);

const day = 24 * 60 * 60 * 1000;
const week = 7 * day;

const points: Entry[] = [...measured].sort((a, b) => time(a.date) - time(b.date));
const targetLine: Entry[] = [target.start, target.end];
const targetStart = time(target.start.date);
const targetEnd = time(target.end.date);
const goalWeight = target.end.weight;
const weeklyTarget = (target.start.weight - goalWeight) / ((targetEnd - targetStart) / week);

// Trend: least-squares fit over actual timestamps, so irregular intervals are weighted correctly
const meanT = points.reduce((s, p) => s + time(p.date), 0) / points.length;
const meanW = points.reduce((s, p) => s + p.weight, 0) / points.length;
const varT = points.reduce((s, p) => s + (time(p.date) - meanT) ** 2, 0);
const slope = varT > 0 ? points.reduce((s, p) => s + (time(p.date) - meanT) * (p.weight - meanW), 0) / varT : 0;
const trendAt = (t: number) => meanW + slope * (t - meanT);
const avgPerWeek = -slope * week;

const firstTime = time(points[0].date);
const lastTime = time(points[points.length - 1].date);
const goalTime = slope < 0 ? meanT + (goalWeight - meanW) / slope : null;
// Keep a very slow trend from stretching the chart indefinitely
const trendLimit = targetEnd + (targetEnd - targetStart) / 2;
const trendEnd = Math.max(lastTime, Math.min(goalTime ?? lastTime, trendLimit));
const trendLine: Entry[] = [firstTime, trendEnd].map(t => ({ date: new Date(t).toISOString(), weight: trendAt(t) }));
const goalOnChart = goalTime !== null && goalTime <= trendEnd;

// Chart geometry
const width = 900;
const height = 600;
const margin = { top: 12, right: 24, bottom: 40, left: 40 };

const times = [...targetLine, ...points, ...trendLine].map(e => time(e.date));
const weights = [...targetLine, ...points, ...trendLine].map(e => e.weight);
const tMin = Math.min(...times);
const tMax = Math.max(...times);
const kgMin = Math.floor(Math.min(...weights)) - 1;
const kgMax = Math.ceil(Math.max(...weights)) + 1;

const x = (t: number) => margin.left + (t - tMin) / (tMax - tMin) * (width - margin.left - margin.right);
const y = (kg: number) => margin.top + (kgMax - kg) / (kgMax - kgMin) * (height - margin.top - margin.bottom);

const polyline = (entries: Entry[]) => entries.map(e => `${x(time(e.date))},${y(e.weight)}`).join(' ');

// Ticks
const kgTicks = Array.from({ length: kgMax - kgMin + 1 }, (_, i) => kgMin + i);

const monthTicks: number[] = [];
const cursor = new Date(tMin);
cursor.setUTCDate(1);
cursor.setUTCHours(0, 0, 0, 0);
while (cursor.getTime() <= tMax) {
	if (cursor.getTime() >= tMin) monthTicks.push(cursor.getTime());
	cursor.setUTCMonth(cursor.getUTCMonth() + 1);
}

const mondayTicks: number[] = [];
const firstDay = new Date(tMin);
firstDay.setUTCHours(0, 0, 0, 0);
for (let t = firstDay.getTime() + ((8 - firstDay.getUTCDay()) % 7) * day; t <= tMax; t += 7 * day) {
	if (t >= tMin) mondayTicks.push(t);
}

const monthLabel = (t: number) => new Date(t).toLocaleDateString('en', { month: 'short', timeZone: 'UTC' });

// Next week range: trend line vs target line at the upcoming Monday after the last measurement
const daysToMonday = (8 - new Date(lastTime).getUTCDay()) % 7 || 7;
const nextMonday = lastTime + daysToMonday * day;
const projected = trendAt(nextMonday);
const onTargetLine = target.start.weight + (nextMonday - targetStart) / (targetEnd - targetStart) * (target.end.weight - target.start.weight);
const [rangeLow, rangeHigh] = [projected, onTargetLine].sort((a, b) => a - b);
const nextMondayLabel = new Date(nextMonday).toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit', timeZone: 'UTC' });

// Time progress based on latest measurement date
const progressPercent = Math.round(((lastTime - targetStart) / (targetEnd - targetStart)) * 100);
const weeksFinished = Math.floor((lastTime - targetStart) / week);
const totalWeeks = Math.ceil((targetEnd - targetStart) / week);

const fullDate = (t: number) => new Date(t).toLocaleDateString('de-DE', { day: '2-digit', month: '2-digit', year: 'numeric', timeZone: 'UTC' });
const goalDateLabel = goalTime !== null ? fullDate(goalTime) : '—';
const targetEndLabel = fullDate(targetEnd);
---

<Layout title="Tracking">
	<figure class="chart">
		<div class="stats">
			<div class="stat">
				<span class="stat-label">Time elapsed</span>
				<span class="stat-value">{progressPercent}<small>%</small></span>
				<span class="stat-note">{weeksFinished} / {totalWeeks} weeks done</span>
			</div>
			<div class="stat">
				<span class="stat-label">Next week target</span>
				<span class="stat-value">{rangeLow.toFixed(1)}–{rangeHigh.toFixed(1)}<small>kg</small></span>
				<span class="stat-note">For {nextMondayLabel}</span>
			</div>
			<div class="stat">
				<span class="stat-label">Average rate</span>
				<span class="stat-value">{avgPerWeek.toFixed(2)}<small>kg/wk</small></span>
				<span class="stat-note">Target {weeklyTarget.toFixed(2)} kg/wk</span>
			</div>
			<div class="stat">
				<span class="stat-label">Projected goal hit</span>
				<span class="stat-value">{goalDateLabel}</span>
				<span class="stat-note">Target {targetEndLabel}</span>
			</div>
		</div>

		<svg viewBox={`0 0 ${width} ${height}`} role="img" aria-label="Weight over time">
			{mondayTicks.map(t => (
				<line class="grid" x1={x(t)} x2={x(t)} y1={y(kgMax)} y2={y(kgMin)}/>
			))}

			{kgTicks.map(kg => (
				<>
					<line class="grid" x1={margin.left} x2={width - margin.right} y1={y(kg)} y2={y(kg)}/>
					<text class="label" x={margin.left - 12} y={y(kg)} text-anchor="end" dominant-baseline="middle">{kg}</text>
				</>
			))}

			{monthTicks.map(t => (
				<text class="label" x={x(t)} y={height - margin.bottom + 24} text-anchor="middle">{monthLabel(t)}</text>
			))}

			<line class="goal" x1={margin.left} x2={width - margin.right} y1={y(target.end.weight)} y2={y(target.end.weight)}/>

			<polyline class="target" points={polyline(targetLine)}/>
			<polyline class="trend" points={polyline(trendLine)}/>
			<polyline class="actual" points={polyline(points)}/>

			{goalOnChart && (
				<circle class="goal-dot" cx={x(goalTime!)} cy={y(goalWeight)} r="5">
					<title>{goalDateLabel}</title>
				</circle>
			)}

			{points.map(p => (
				<circle class="dot" cx={x(time(p.date))} cy={y(p.weight)} r="4">
					<title>{p.weight} kg</title>
				</circle>
			))}
		</svg>

		<figcaption>
			<span class="key target-key">Target</span>
			<span class="key trend-key">Trend</span>
			<span class="key goal-key">Goal</span>
			<span class="key actual-key">Data</span>
		</figcaption>
	</figure>
</Layout>

<style>
	.chart {
		margin: 0;
		/* 16px at the 960px max width; everything inside uses em so it scales with the SVG */
		font-size: calc(100cqi / 60);
		padding: 2em;
		background: var(--surface);
		border-radius: 0.75em;
	}

	.stats {
		display: grid;
		grid-template-columns: repeat(4, 1fr);
		margin-bottom: 1.5em;
	}

	.stat {
		display: flex;
		flex-direction: column;
		gap: 0.3em;
		padding: 0 1.25em;
		border-left: 1px solid var(--grid);
	}

	.stat:first-child {
		padding-left: 0;
		border-left: none;
	}

	.stat:last-child {
		padding-right: 0;
	}

	.stat-label {
		color: var(--muted);
		font-size: 0.7em;
		letter-spacing: 0.08em;
		text-transform: uppercase;
		white-space: nowrap;
	}

	.stat-value {
		color: var(--text);
		opacity: 0.85;
		font-size: 1.6em;
		font-weight: 600;
		font-variant-numeric: tabular-nums;
		line-height: 1.1;
		white-space: nowrap;
	}

	.stat-value small {
		margin-left: 0.15em;
		font-size: 0.55em;
		font-weight: 400;
	}

	.stat-note {
		color: var(--prediction);
		font-size: 0.75em;
		white-space: nowrap;
	}

	svg {
		display: block;
		width: 100%;
		height: auto;
		overflow: visible;
	}

	.grid {
		stroke: var(--grid);
		stroke-width: 1;
	}

	.goal {
		stroke: var(--goal);
		stroke-width: 1.5;
		opacity: 0.55;
	}

	.label {
		fill: var(--muted);
		font-size: 13px;
	}

	.target {
		fill: none;
		stroke: var(--prediction);
		stroke-width: 2;
		stroke-dasharray: 8 6;
	}

	.trend {
		fill: none;
		stroke: var(--trend);
		stroke-width: 2;
		stroke-dasharray: 2 5;
		stroke-linecap: round;
	}

	.goal-dot {
		fill: var(--surface);
		stroke: var(--trend);
		stroke-width: 2;
	}

	.actual {
		fill: none;
		stroke: var(--actual);
		stroke-width: 2.5;
		stroke-linejoin: round;
	}

	.dot {
		fill: var(--actual);
	}

	figcaption {
		display: flex;
		flex-wrap: wrap;
		gap: 1.667em;
		margin-top: 1.111em;
		color: var(--muted);
		font-size: 0.9em;
	}

	.key::before {
		content: '';
		display: inline-block;
		width: 0.972em;
		height: 2px;
		margin-right: 0.556em;
		vertical-align: middle;
	}

	.target-key::before {
		background: var(--prediction);
	}

	.trend-key::before {
		background: var(--trend);
	}

	.goal-key::before {
		background: var(--goal);
	}

	.actual-key::before {
		background: var(--actual);
	}
</style>
